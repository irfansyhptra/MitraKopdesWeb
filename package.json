{
  "name": "kopdes-website",
  "version": "0.1.0",
  "private": true,
  "description": "Website KMP Mitra \u2014 landing promosi + app pelanggan/staf, satu backend NestJS.",
  "workspaces": [
    "app",
    "landing"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=app",
    "dev:app": "npm run dev --workspace=app",
    "dev:landing": "npm run dev --workspace=landing",
    "build": "npm run build --workspace=app && npm run build --workspace=landing",
    "build:app": "npm run build --workspace=app",
    "build:landing": "npm run build --workspace=landing",
    "start": "npm run start --workspace=app",
    "typecheck": "npm run typecheck --workspace=app && npm run typecheck --workspace=landing",
    "lint": "eslint app landing shared test scripts",
    "test": "vitest run",
    "audit:responsive": "node scripts/audit-responsive.mjs",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
